generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS

model User {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash String

  name String

  groups UserInGroup[]

  @@map("users")
}

model Group {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  description String?
  visualization GroupVisualization

  users UserInGroup[]

  players Player[]
  matches Match[]
  teams Team[]

  @@map("groups")
}

model UserInGroup {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  groupId String @db.Uuid
  role UserInGroupRole @default(VIEWER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])

  @@map("users_in_groups")
}

model Player {
  id String @id @default(uuid()) @db.Uuid
  name String
  description String?

  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  teams PlayerInTeam[]

  @@map("players")
}

model Match {
  id String @id @default(uuid()) @db.Uuid
  date DateTime @default(now())
  teams TeamInMatch[]

  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("matches")
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  name String

  groupId  String @db.Uuid
  group    Group  @relation(fields: [groupId], references: [id])

  match TeamInMatch[]

  @@map("teams")
}

model TeamInMatch {
  id        String        @id @default(uuid()) @db.Uuid
  matchId   String        @db.Uuid
  teamId    String        @db.Uuid
  result    TeamResults?
  score     Int?

  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players   PlayerInTeam[] 

  @@unique([matchId, teamId]) 
  @@map("teams_in_matches")
}

model PlayerInTeam {
  id            String        @id @default(uuid()) @db.Uuid
  teamInMatchId String        @db.Uuid
  playerId      String        @db.Uuid
  isActive      Boolean?      @default(true)

  teamInMatch   TeamInMatch   @relation(fields: [teamInMatchId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamInMatchId, playerId]) 
  @@map("players_in_teams")
}



// ENUMS

enum GroupVisualization {
  PUBLIC
  PRIVATE

  @@map("group_visualization_enum")
}

enum UserInGroupRole {
  OWNER
  ADMIN
  VIEWER

  @@map("user_in_group_role_enum")
}

enum TeamResults {
  WIN
  LOSE
  TIE

  @@map("team_results_enum")
}

